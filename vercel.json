{
  "redirects": [
    {
      "source": "/choeae-about.html",
      "destination": "/about.html",
      "statusCode": 301
    },
    {
      "source": "/choeae-faq.html",
      "destination": "/faq.html",
      "statusCode": 301
    },
    {
      "source": "/choeae-privacy.html",
      "destination": "/privacy.html",
      "statusCode": 301
    },
    {
      "source": "/choeae-terms.html",
      "destination": "/terms.html",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/twemoji/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(fonts|screens)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
